rules_version = '2';

// Security model note: this app has no full account system — a "call
// code" is a bearer secret, the same way it already is for starting a
// voice/video call. These rules require at least an (anonymous) signed-in
// session, validate the shape of every message, and check the sender code
// is actually one of the two codes that make up the conversation id. They
// do NOT cryptographically prove a given device owns a given call code
// (there's no login system for that yet) — someone who already knows both
// call codes for a conversation could still read/write it. That mirrors
// the existing calling feature's security model (see chat history).
service cloud.firestore {
  match /databases/{database}/documents {
    // Real account profiles (see lib/auth.ts). Any signed-in user can read
    // any profile — that's what lets a device match its local address book
    // against Hoox (lib/contacts.ts) without a server in between. Writes
    // are locked to the profile's own owner, and phoneNumber/uid can't be
    // changed after creation (they're tied to the Firebase Auth identity
    // that created the doc).
    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'avatarSeed', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60;

      allow delete: if false;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth != null
        && conversationId.matches('^[A-Z2-9]{6}_[A-Z2-9]{6}$');

      allow create: if request.auth != null
        && conversationId.matches('^[A-Z2-9]{6}_[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['text', 'senderCode', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.senderCode is string
        && (
          request.resource.data.senderCode == conversationId[0:6]
          || request.resource.data.senderCode == conversationId[7:13]
        )
        && request.resource.data.createdAt == request.time;

      // Messages are immutable once sent — no edits, no deletes.
      allow update, delete: if false;
    }
  }
}
